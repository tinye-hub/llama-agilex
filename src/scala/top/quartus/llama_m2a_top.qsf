# -------------------------------------------------------------------------- #
# LlamaM2aTop — Agilex 5E stand-alone synthesis (resource + timing estimate)
# QSF style aligned with rmsNorm / ldpc resource-estimate flows.
# Run from src/scala/top:  make quartus-m2a
# -------------------------------------------------------------------------- #

set_global_assignment -name TOP_LEVEL_ENTITY LlamaM2aTop
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "25.1.0 Pro Edition"
set_global_assignment -name PROJECT_CREATION_TIME_DATE "2026.06.26"
set_global_assignment -name LAST_QUARTUS_VERSION "25.1.1 SP1.31 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name DEVICE A5EB013BB23BE4SCS
set_global_assignment -name FAMILY "Agilex 5"
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 256
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Intel FPGA (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "LINEAR FORMAT"
set_global_assignment -name PWRMGT_LINEAR_FORMAT_N "-12"

# Quartus FP IP (same set as Questa compile_ips.tcl / rmsNorm quart CSS)
set_global_assignment -name IP_FILE ../../../../quartus_ip/fp16ToFp32.ip
set_global_assignment -name IP_FILE ../../../../quartus_ip/fp32ToFp16.ip
set_global_assignment -name IP_FILE ../../../../quartus_ip/fp32Rsqrt.ip
set_global_assignment -name IP_FILE ../../../../quartus_ip/fp32MultAcc.ip
set_global_assignment -name IP_FILE ../../../../quartus_ip/fp32Add.ip

# Spinal-generated synthesizable RTL (M2a: scheduler + ddrAgent + rmsNorm + gemv)
set_global_assignment -name VERILOG_FILE ../gen/verilog/LlamaM2aTop.v

# Stand-alone resource estimate: all top-level I/O are virtual pins.
# io_ddrAxi remains unconstrained to board EMIF (DDR controller not integrated yet).
set_instance_assignment -name VIRTUAL_PIN ON -to * -entity LlamaM2aTop

# Timing closure: prioritize Fmax for the final marginal routing-dominated path
# (gemv actBuf BRAM read -> FP DSP mult input). Synthesis/fitter directive only;
# does not alter generated Verilog, so functional behavior is unchanged.
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"

set_global_assignment -name FLOW_ENABLE_POWER_ANALYZER ON
set_global_assignment -name SDC_FILE constraints/llama_m2a_top.sdc
set_global_assignment -name POWER_TJ_VALUE 100
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL
set_global_assignment -name FLOW_DISABLE_ASSEMBLER ON
